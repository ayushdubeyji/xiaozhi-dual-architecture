# ==============================================================================
# Waveshare ESP32-S3-Zero Non-Root Access Rules (Vendor ID 0x303A)
# ==============================================================================

# 1. USB HID Keyboard Descriptor (WakeNet / PTT keystrokes)
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{idVendor}=="303a", MODE="0660", GROUP="input", TAG+="uaccess"

# 2. USB CDC ACM Serial Device (Rover ESP-NOW bridge & audio frames)
KERNEL=="ttyACM*", SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", MODE="0666", GROUP="dialout", SYMLINK+="ttyS3Zero"

# 3. USB RNDIS Network Interface
SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="303a", NAME="usb0"
