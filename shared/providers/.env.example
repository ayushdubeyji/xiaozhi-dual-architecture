# Xiaozhi Cloud ASR & Multi-LLM Router Environment Configuration Template
# Copy this file to .env and insert your real API keys

# Groq Cloud API (Whisper ASR & Fast LLM)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Keys (Primary & Automatic Failover Backup)
GEMINI_API_KEY=your_gemini_primary_api_key_here
GEMINI_BACKUP_API_KEY=your_gemini_backup_api_key_here

# xAI Grok API Key
XAI_GROK_API_KEY=your_xai_grok_api_key_here

# Whisper ASR Configuration (Default Groq Cloud Whisper Large v3 Turbo)
WHISPER_API_KEY=your_groq_or_openai_whisper_key_here
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo

# Fallback OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ESP32-S3 Emergency Wi-Fi Credentials
S3_WIFI_SSID=Ayush
S3_WIFI_PASS=YOUR_WIFI_PASSWORD

# Network Host Addresses
WORKBENCH_HOST=192.168.0.111
PI_HOST=192.168.0.112
